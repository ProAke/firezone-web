# Firezone Nuxt CMS Configuration
# ตั้งค่าบัญชีผู้ดูแลระบบเริ่มต้นสำหรับหน้า /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=firezone2026
SESSION_SECRET=firezone-cms-change-this-secret-in-production

# โดเมนต้นทางสำหรับโหลดรูปภาพเดิมกรณีที่ยังไม่ได้รัน npm run migrate:media
WP_MEDIA_ORIGIN=https://fireszone.com

