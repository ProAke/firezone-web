# Firezone Nuxt CMS Configuration
# ตั้งค่าบัญชีผู้ดูแลระบบเริ่มต้นสำหรับหน้า /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=firezone2026
SESSION_SECRET=firezone-cms-change-this-secret-in-production

# แหล่งสำรองไฟล์รูปภาพเดิม (สำหรับดึงรูปอัตโนมัติมาเก็บใน data/uploads/wp/)
WP_BACKUP_UPLOADS_URL=https://fz.uarea.in/uploads
WP_MEDIA_ORIGIN=https://fz.uarea.in

